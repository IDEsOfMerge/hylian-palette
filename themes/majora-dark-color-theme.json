  "tokenColors": [
    { "scope": ["comment", "comment.line", "comment.block"], "settings": { "foreground": "#8388AD", "fontStyle": "italic" } },
    { "scope": ["comment.block.documentation", "comment.documentation"], "settings": { "foreground": "#8388AD", "fontStyle": "italic" } },
    { "scope": ["comment.block.documentation storage.type.class", "comment.block.documentation keyword", "punctuation.definition.tag.documentation"], "settings": { "foreground": "#5FD9C4", "fontStyle": "bold italic" } },
    { "scope": ["keyword.control", "keyword.control.flow", "keyword.control.import", "keyword.control.export", "keyword", "keyword.other"], "settings": { "foreground": "#FF4D8D", "fontStyle": "bold" } },
    { "scope": ["keyword.operator", "keyword.operator.assignment", "keyword.operator.comparison", "keyword.operator.logical", "keyword.operator.arithmetic"], "settings": { "foreground": "#9A8FB0" } },
    { "scope": ["storage.type", "storage"], "settings": { "foreground": "#E8C872", "fontStyle": "bold" } },
    { "scope": ["storage.modifier"], "settings": { "foreground": "#E8C872", "fontStyle": "italic" } },
    { "scope": ["string.quoted", "string.template", "string", "string.interpolated"], "settings": { "foreground": "#FFB347" } },
    { "scope": ["string.regexp"], "settings": { "foreground": "#FF6EC7" } },
    { "scope": ["constant.character.escape"], "settings": { "foreground": "#7FFFD4" } },
    { "scope": ["constant.numeric"], "settings": { "foreground": "#FFD166" } },
    { "scope": ["constant.language.boolean", "constant.language"], "settings": { "foreground": "#FFD166", "fontStyle": "bold" } },
    { "scope": ["constant.other", "constant.other.enummember"], "settings": { "foreground": "#00F5D4" } },
    { "scope": ["entity.name.function", "meta.function-call", "support.function"], "settings": { "foreground": "#B47EE5" } },
    { "scope": ["support.function.builtin", "support.function.magic"], "settings": { "foreground": "#9A7FC7" } },
    { "scope": ["entity.name.function.member", "meta.method", "meta.function-call.method"], "settings": { "foreground": "#B47EE5" } },
    { "scope": ["variable", "variable.other.readwrite", "variable.other.object"], "settings": { "foreground": "#CBBEDC" } },
    { "scope": ["variable.language", "variable.language.this", "variable.language.self"], "settings": { "foreground": "#CBBEDC", "fontStyle": "italic bold" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#B9AECB", "fontStyle": "italic" } },
    { "scope": ["variable.other.property", "variable.other.object.property", "meta.object-literal.key"], "settings": { "foreground": "#A7B4E0" } },
    { "scope": ["entity.name.type.class", "entity.name.class", "support.class"], "settings": { "foreground": "#00F5D4", "fontStyle": "bold" } },
    { "scope": ["entity.name.type", "support.type"], "settings": { "foreground": "#00F5D4" } },
    { "scope": ["entity.name.type.interface"], "settings": { "foreground": "#7FFFD4", "fontStyle": "italic" } },
    { "scope": ["entity.name.type.enum"], "settings": { "foreground": "#00F5D4", "fontStyle": "bold" } },
    { "scope": ["entity.name.namespace", "entity.name.type.module", "entity.name.type.namespace"], "settings": { "foreground": "#9B8AC4" } },
    { "scope": ["meta.decorator", "punctuation.decorator", "entity.name.function.decorator"], "settings": { "foreground": "#E3B23C", "fontStyle": "italic" } },
    { "scope": ["punctuation", "punctuation.separator", "punctuation.terminator", "punctuation.definition"], "settings": { "foreground": "#9A8FB0" } },
    { "scope": ["punctuation.definition.tag"], "settings": { "foreground": "#9A8FB0" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#FF4D8D" } },
