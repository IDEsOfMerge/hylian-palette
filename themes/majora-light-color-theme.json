      ],
      "settings": {
        "foreground": "#8A6018",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#8A6018",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
