    "commands": [
      {
        "command": "hylianPalette.toggleTheme",
        "title": "Hylian Palette: Toggle Theme"
      },
      {
        "command": "hylianPalette.pickTheme",
        "title": "Hylian Palette: Pick Zelda Theme"
      },
      {
        "command": "hylianPalette.pickSimilarTheme",
        "title": "Hylian Palette: Pick Similar Theme (CIEDE2000)"
      },
      {
        "command": "hylianPalette.randomTheme",
        "title": "Hylian Palette: Random Theme"
      },
      {
        "command": "hylianPalette.randomThemeSameMode",
        "title": "Hylian Palette: Random Theme (Same Mode)"
      },
      {
        "command": "hylianPalette.syncOsThemePair",
        "title": "Hylian Palette: Sync Current Game with OS Light/Dark"
      },
      {
        "command": "hylianPalette.openExplorer",
        "title": "Hylian Palette: Open Palette & Colorimetry Explorer"
      }
    ],
    "configuration": {
      "title": "Hylian Palette",
      "properties": {
        "hylianPalette.showStatusBarItem": {
          "type": "string",
          "enum": [
            "always",
            "whenActive",
            "never"
          ],
          "enumDescriptions": [
            "Always display the Hylian Palette quick-picker item in the status bar.",
            "Only display the status bar item while a Hylian Palette theme is active.",
            "Hide the Hylian Palette status bar item completely."
          ],
          "default": "always",
          "markdownDescription": "Controls when the **Hylian Palette** theme picker item is visible in the status bar (`always`, `whenActive`, or `never`)."
        }
      }
    },
    "keybindings": [
      {
        "command": "hylianPalette.toggleTheme",
        "key": "ctrl+k ctrl+z",
        "mac": "cmd+k cmd+z"
      }
    ],
    "walkthroughs": [
      {
        "id": "hylianPalette.gettingStarted",
        "title": "Welcome to Hylian Palette",
        "description": "18 mainline Zelda games · 36 scientifically tuned themes — a quick tour.",
        "steps": [
          {
            "id": "pickTheme",
            "title": "Pick your first theme (with live preview)",
            "description": "Every mainline Zelda game from 1986 to 2024 gets a Light and a Dark theme crafted in OKLCH from that game's authentic art direction. Arrow through the list to preview live before committing.\n[Pick a Zelda Theme](command:hylianPalette.pickTheme)",
            "media": {
              "image": "icon.png",
              "altText": "Hylian Palette emblem"
            },
            "completionEvents": [
              "onCommand:hylianPalette.pickTheme"
            ]
          },
          {
            "id": "toggle",
            "title": "Toggle Light and Dark",
            "description": "A smart, per-game toggle — flips between the Light and Dark variant of whichever game's theme is active. Bound to `ctrl+k ctrl+z` (`cmd+k cmd+z` on Mac), or run it from the Command Palette.\n[Toggle Theme](command:hylianPalette.toggleTheme)",
            "media": {
              "markdown": "assets/walkthrough/toggle.md"
            },
            "completionEvents": [
              "onCommand:hylianPalette.toggleTheme",
              "onCommand:windwakerMajora.toggleTheme"
            ]
          },
          {
            "id": "story",
            "title": "Every pair tells a story",
            "description": "Ocarina of Time's syntax colors are the three Spiritual Stones plus the royal-indigo Ocarina. Twilight Princess Dark lowers OKLCH chroma across every token except Midna's blazing orange. Link's Awakening Dark honors the real 1993 DMG-01 LCD green ramp, and Echoes of Wisdom steps from Zelda's cloak into the Still World.",
            "media": {
              "image": "icon.png",
              "altText": "Hylian Palette Light and Dark emblem"
            }
          },
          {
            "id": "colorScience",
            "title": "Launch the Interactive Palette & Colorimetry Explorer",
            "description": "Inspect OKLCH coordinates, WCAG 2.1 + APCA contrast, OKLab chromaticity polygons, and real-time protanopia/deuteranopia/tritanopia simulations across all 36 themes — and live-sync any theme straight into your editor.\n[Open Interactive Explorer](command:hylianPalette.openExplorer)",
            "media": {
              "markdown": "assets/walkthrough/color-science.md"
            },
            "completionEvents": [
              "onCommand:hylianPalette.openExplorer"
            ]
          }
        ]
      }
    ]
