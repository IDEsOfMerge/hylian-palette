{
  "name": "positron-hylian-palette",
  "displayName": "Hylian Palette — Every Mainline Zelda Game",
  "description": "A Light and Dark color theme for every mainline Legend of Zelda game (17 games, 34 themes) for VS Code and Positron, each with its own rationale-backed palette drawn from that game's art direction. Includes a smart per-game toggle command and a \"Pick Zelda Theme\" quick-pick grouped by game.",
  "version": "0.2.0",
  "publisher": "idesofmerge",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0",
    "positron": ">=2025.1.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "color theme",
    "zelda",
    "hylian",
    "wind waker",
    "majora's mask",
    "ocarina of time",
    "twilight princess",
    "breath of the wild",
    "tears of the kingdom",
    "skyward sword",
    "a link between worlds",
    "a link to the past",
    "link's awakening",
    "dark theme",
    "light theme",
    "positron"
  ],
  "main": "./extension.js",
