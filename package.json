{
  "name": "hylian-palette",
  "displayName": "Hylian Palette — Every Mainline Zelda Game",
  "description": "Created for the 40th anniversary of The Legend of Zelda (1986–2026) — scientifically tuned Light and Dark themes for all 18 mainline games (36 themes) for VS Code and Positron, crafted in OKLCH with 100% WCAG AA contrast, APCA hierarchy, and CVD resilience.",
  "version": "1.1.0",
  "publisher": "idesofmerge",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#16102B",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/idesofmerge/hylian-palette.git"
  },
  "bugs": {
    "url": "https://github.com/idesofmerge/hylian-palette/issues"
  },
  "homepage": "https://idesofmerge.github.io/hylian-palette/",
  "engines": {
    "vscode": "^1.90.0",
    "positron": ">=2025.1.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "color theme",
    "zelda",
    "hylian",
    "40th anniversary",
    "echoes of wisdom",
    "tears of the kingdom",
    "breath of the wild",
    "wind waker",
    "majora's mask",
    "ocarina of time",
    "twilight princess",
    "skyward sword",
    "a link between worlds",
    "a link to the past",
    "link's awakening",
    "oklch",
    "accessible",
    "colorblind",
    "dark theme",
    "light theme",
    "positron"
  ],
  "main": "./extension.js",
  "scripts": {
    "build": "node scripts/generate-themes.js && node scripts/generate-explorer.js",
    "themes": "node scripts/generate-themes.js",
    "explorer": "node scripts/generate-explorer.js",
    "swatches": "node scripts/generate-swatches.js",
    "validate": "node scripts/validate.js",
    "test": "node --test test/*.test.js",
    "package": "npx --yes @vscode/vsce package"
  },
