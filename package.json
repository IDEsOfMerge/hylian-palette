{
  "name": "positron-hylian-palette",
  "displayName": "Hylian Palette — Every Mainline Zelda Game",
  "description": "Scientifically tuned Light and Dark color themes for every mainline Legend of Zelda game (18 games, 36 themes, 1986–2024) for VS Code and Positron — crafted in OKLCH from each game's authentic art direction with 100% WCAG AA contrast, APCA hierarchy, and color-blindness resilience.",
  "version": "1.0.0",
  "publisher": "idesofmerge",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#16102B",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/idesofmerge/positron-hylian-palette.git"
  },
  "bugs": {
    "url": "https://github.com/idesofmerge/positron-hylian-palette/issues"
  },
  "homepage": "https://idesofmerge.github.io/positron-hylian-palette/",
  "engines": {
    "vscode": "^1.90.0",
    "positron": ">=2025.1.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "categories": [
    "Themes"
  ],
